# PayPal: "mock" (default) or "sandbox"
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Shop payout receivers (sandbox business account emails)
PAYOUT_EMAIL_BAKERY=
PAYOUT_EMAIL_CAFE=
PAYOUT_EMAIL_NOODLES=
PAYOUT_EMAIL_GREENS=

# Database: empty = in-memory mock
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenAI-compatible). Empty key = deterministic handoff fallback.
# Muse Spark:  https://api.meta.ai/v1      muse-spark-1.1
# OpenRouter:  https://openrouter.ai/api/v1  openai/gpt-6-luna  (uses OPENROUTER_API_KEY)
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.1
OPENROUTER_API_KEY=

# Phone call ordering: AssemblyAI speech-to-text + text-to-speech, Muse Spark runs the call.
# The call always uses Muse Spark (META_API_KEY, or LLM_API_KEY when LLM_BASE_URL is Meta).
ASSEMBLYAI_API_KEY=
# TTS_VOICE=aai-sara
META_API_KEY=
# SPARK_MODEL=muse-spark-1.1

# Guided tour over the landing page and /demo: "on" to offer it to first-time visitors
TOUR=on

# PayPal sandbox buyer logins shown under the demo phone for testers (sandbox mode only):
# "email password, email password"
SANDBOX_BUYERS=

# Optional: protects /api/cron/keepalive (Vercel sends it as a bearer token)
CRON_SECRET=
